# Auto-generated by test/cpp/CMakeLists.txt. Attaches CTest fixtures to
# tests discovered lazily by doctest_discover_tests, which otherwise runs
# *after* normal CMake time.
#
# Two fixtures are wired:
#   * `gpu_available`     -> every test with label `gpu`
#   * `synthetic_fixtures`-> every test whose name starts with a binary
#                            listed in OVR_FIXTURE_CONSUMERS

get_property(_all_tests DIRECTORY PROPERTY TESTS)

# Pre-compute prefixes, each "<consumer>." starts a discovered test name.
set(_fixture_consumers "@OVR_FIXTURE_CONSUMERS_STR@")

foreach(_t IN LISTS _all_tests)
  get_property(_labels TEST ${_t} PROPERTY LABELS)
  if("gpu" IN_LIST _labels)
    set_property(TEST ${_t} APPEND PROPERTY FIXTURES_REQUIRED gpu_available)
  endif()

  foreach(_c IN LISTS _fixture_consumers)
    if("${_t}" MATCHES "^${_c}\\." OR "${_t}" STREQUAL "${_c}")
      set_property(TEST ${_t} APPEND PROPERTY FIXTURES_REQUIRED synthetic_fixtures)
    endif()
  endforeach()
endforeach()
