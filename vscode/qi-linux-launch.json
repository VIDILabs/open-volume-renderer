    "inputs": [
        {
            "type": "pickString",
            "id": "miniapp",
            "description": "Which mini app do you want to run?",
            "options": [
                "exp_mini_ospray",
                "exp_mini_optix7",
                "exp_mini_torch",
            ]
        },
        {
            "type": "pickString",
            "id": "device",
            "description": "Which mini app do you want to run?",
            "options": [
                "optix7",
                "ospray",
                "vidi3d",
                "cudapt",
                "nncache",
