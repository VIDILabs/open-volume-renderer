    "version": "0.2.0",
    "configurations": [
        {
            "name": "(gdb) vnr_int_isosurface",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildType}/vnr_int_isosurface",
            "args": [
                "--simple-volume", "configs/scene_bonsai.json", 
                // "--neural-volume=params.json", 
                "--isovalue", "0.5"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/data",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":2"
                },
                {
                    "name": "LD_LIBRARY_PATH",
                    "value": "/home/qadwu/Software/ospray-2.11.0.x86_64.linux_sparse_sampling/lib:${env:LD_LIBRARY_PATH}"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "(gdb) vnr_int_dual",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${command:cmake.buildType}/vnr_int_dual",
            "args": [
                "--rendering-mode", "14",
                "--pause-reference",
                "--pause-inference",
                "--pause-training",
                "--volume", 
                "configs/scene_chameleon.json",
                "--network",
                "${workspaceFolder}/projects/instantvnr/example-model.json"
            ],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/data",
            "environment": [
                {
                    "name": "DISPLAY",
                    "value": ":2"
                }
            ],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "description": "Set Disassembly Flavor to Intel",
                    "text": "-gdb-set disassembly-flavor intel",
                    "ignoreFailures": true
                }
            ]
        },
